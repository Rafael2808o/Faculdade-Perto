NODE_ENV=development
PORT=3333
WEB_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
DATABASE_URL=postgres://faculdade:faculdade@localhost:5432/faculdade_perto
# Keep the local PostgreSQL URL here while migrating existing data to CockroachDB.
SOURCE_DATABASE_URL=postgres://faculdade:faculdade@localhost:5432/faculdade_perto
DATABASE_PROVIDER=local
# Use DATABASE_PROVIDER=cockroach with the CockroachDB Cloud connection string.
DATABASE_SSL=auto
DATABASE_POOL_MAX=8
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=120000
DATA_MODE=database
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30
